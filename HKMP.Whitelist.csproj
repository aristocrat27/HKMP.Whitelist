<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="LocalBuildProperties.props"
          Condition="Exists('LocalBuildProperties.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>

    <RootNamespace>HKMP.Whitelist</RootNamespace>
    <AssemblyName>HKMP.Whitelist</AssemblyName>
    <AssemblyTitle>HKMP.Whitelist</AssemblyTitle>

    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <ModOutputPath>$(HollowKnightRefs)\Mods\HKMP.Whitelist</ModOutputPath>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="BouncyCastle.Cryptography"
                      Version="2.7.0" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(HollowKnightRefs)\Assembly-CSharp.dll</HintPath>
    </Reference>

    <Reference Include="PlayMaker">
      <HintPath>$(HollowKnightRefs)\PlayMaker.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="HKMP">
      <HintPath>$(HollowKnightRefs)\Mods\HKMP\HKMP.dll</HintPath>
    </Reference>

    <Reference Include="Satchel">
      <HintPath>$(HollowKnightRefs)\Mods\Satchel\Satchel.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(HollowKnightRefs)\UnityEngine.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.UI">
      <HintPath>$(HollowKnightRefs)\UnityEngine.UI.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>

    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HollowKnightRefs)\Newtonsoft.Json.dll</HintPath>
    </Reference>

    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(HollowKnightRefs)\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>

    <Reference Include="MonoMod.Utils">
      <HintPath>$(HollowKnightRefs)\MonoMod.Utils.dll</HintPath>
    </Reference>

  </ItemGroup>

  <Target Name="ValidateLocalBuildProperties"
          BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HollowKnightRefs)' == ''"
           Text="HollowKnightRefs is not configured. Create LocalBuildProperties.props next to HKMP.Whitelist.csproj." />
  </Target>

  <Target Name="CopyModToGame"
          AfterTargets="Build">

    <MakeDir Directories="$(ModOutputPath)" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModOutputPath)"
          SkipUnchangedFiles="true" />

  </Target>

</Project>
